{
  "name": "libram-shift-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:game-data && npm run build:css",
    "build:game-data": "node scripts/build-game-data.js",
    "build:css": "sass src/scss:src/css --no-source-map",
    "watch:css": "sass --watch src/scss:src/css --no-source-map"
  },
  "devDependencies": {
    "sass": "1.89.2"
  }
}
